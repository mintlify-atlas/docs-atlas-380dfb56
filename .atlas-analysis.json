  "keyFeatures": [
    "Squad roster with player stats (goals, assists, cards)",
    "Match calendar with results and upcoming fixtures",
    "League standings table",
    "Official merchandise store with cart and checkout",
    "JWT-based user authentication and registration",
    "Role-based access control (admin vs regular user)",
    "Admin dashboard with tabs for players, matches, rankings, store, and sales",
    "Order management with status tracking (pending, paid, shipped)",
    "Automatic stock management on purchase"
  ],
